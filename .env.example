# Environment variables for local development
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed

# GitHub OAuth App Client ID (from github.com/settings/developers)
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Cloudflare Worker URL for OAuth token exchange
# See workers/oauth-proxy/index.js for deployment instructions
VITE_OAUTH_PROXY_URL=https://your-worker.your-username.workers.dev
